<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host references every project in src/, so their assemblies land next to the tests. SDK projects
         (sdk/) are not referenced by the host and are added here when they are created. -->
    <ProjectReference Include="..\..\src\Tahsil.Server\Tahsil.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests find the repository's project files. Caller file paths do not work for this: CI builds
         map source paths to /_/. -->
    <AssemblyMetadata Include="ProjectDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

</Project>
