@page "/admin/invoices"
@attribute [Authorize(Policy = AdminAuthentication.Policy)]
@using Tahsil.Application.Invoices
@inherits AdminPageBase

<PageTitle>Invoices · Tahsil</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom>Invoices</MudText>

<MudStack Row Class="mb-4" AlignItems="AlignItems.End">
    <MudSelect T="InvoiceStatus?" @bind-Value="_status" Label="Status" Clearable Style="max-width: 12rem" id="status">
        @foreach (var status in Enum.GetValues<InvoiceStatus>())
        {
            <MudSelectItem T="InvoiceStatus?" Value="status">@status.ToString().ToLowerInvariant()</MudSelectItem>
        }
    </MudSelect>
    <MudTextField @bind-Value="_number" Label="Number" Clearable Style="max-width: 16rem" id="number" />
    <MudCheckBox T="bool" @bind-Value="_inDunning" Label="In dunning" id="in-dunning" />
    <MudCheckBox T="bool" @bind-Value="_overdue" Label="Overdue" id="overdue" />
    <MudButton Variant="Variant.Outlined" OnClick="SearchAsync" id="search-button">Search</MudButton>
</MudStack>

<InvoiceTable Invoices="_invoices" />

@if (_nextCursor is not null)
{
    <MudButton Class="mt-4" Variant="Variant.Text" OnClick="LoadMoreAsync">Load more</MudButton>
}

@code {
    private readonly List<InvoiceResponse> _invoices = [];
    private string? _nextCursor;

    // Each search starts a new generation; a page still loading for an earlier one is dropped.
    private int _generation;
    private InvoiceStatus? _status;
    private string? _number;
    private bool _inDunning;
    private bool _overdue;

    protected override Task OnInitializedAsync() => LoadMoreAsync();

    private async Task SearchAsync()
    {
        _invoices.Clear();
        _generation++;
        _nextCursor = null;
        await LoadMoreAsync();
    }

    private async Task LoadMoreAsync()
    {
        var generation = _generation;
        var query = new ListInvoicesQuery(
            Status: _status, Number: string.IsNullOrWhiteSpace(_number) ? null : _number.Trim(), Cursor: _nextCursor, InDunning: _inDunning, Overdue: _overdue);
        if (await ReadAsync<ListInvoicesHandler, Page<InvoiceResponse>>((handler, token) => handler.HandleAsync(query, token)) is { } page && generation == _generation)
        {
            _invoices.AddRange(page.Items);
            _nextCursor = page.NextCursor;
        }
    }
}
