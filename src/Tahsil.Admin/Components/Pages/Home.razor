@page "/admin"
@attribute [Authorize(Policy = AdminAuthentication.Policy)]
@using Tahsil.Application.AttentionItems
@using Tahsil.Application.Dashboard
@inherits AdminPageBase
@inject Microsoft.Extensions.Options.IOptions<ServerOptions> Server

<PageTitle>Tahsil</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom>Welcome</MudText>
<MudText Class="mb-6">Signed in as @(Session.Email ?? Session.Subject), with the @Session.Role role.</MudText>

@if (_attention > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-6" id="attention-alert">
        @(_attention == 1 ? "One item needs" : $"{_attention} items need") attention. <MudLink Href="/admin/attention">Look into them</MudLink>
    </MudAlert>
}

@if (_figures is { Currencies.Count: > 0 } figures)
{
    <MudTable T="CurrencyFigures" Items="figures.Currencies" Dense Class="mb-2" id="figures">
        <HeaderContent>
            <MudTh>Currency</MudTh>
            <MudTh>MRR</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Trialing</MudTh>
            <MudTh>New this month</MudTh>
            <MudTh>Ended this month</MudTh>
            <MudTh>Revenue, 30 days</MudTh>
            <MudTh>Failed payments, 30 days</MudTh>
            <MudTh>Recovered, 30 days</MudTh>
            <MudTh>Awaiting the provider</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Currency">@context.Currency</MudTd>
            <MudTd DataLabel="MRR" Class="mrr">@AdminFormat.Money(context.Mrr, context.Currency)</MudTd>
            <MudTd DataLabel="Active">@context.Active</MudTd>
            <MudTd DataLabel="Trialing">@context.Trialing</MudTd>
            <MudTd DataLabel="New this month">@context.NewThisMonth</MudTd>
            <MudTd DataLabel="Ended this month">@context.ChurnedThisMonth</MudTd>
            <MudTd DataLabel="Revenue, 30 days" Class="revenue">@AdminFormat.Money(context.Revenue, context.Currency)</MudTd>
            <MudTd DataLabel="Failed payments, 30 days">@context.FailedPayments</MudTd>
            <MudTd DataLabel="Recovered, 30 days" Class="recovery">@(context.RecoveryRate is { } rate ? $"{context.Recovered} of {context.DunningStarted} invoices ({(rate * 100).ToString("0", CultureInfo.InvariantCulture)}%)" : "–")</MudTd>
            <MudTd DataLabel="Awaiting the provider">@context.AwaitingReconciliation</MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.caption" Class="mb-6" HtmlTag="p" id="figures-note">
        As of <Moment Value="figures.ComputedAt" />, refreshed every five minutes. MRR is without tax and metered usage; subscriptions past due count as active. These are operational figures, not accounting reports.
    </MudText>
}

<MudGrid>
    @foreach (var item in NavMenu.VisibleItems(Session, Server.Value))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Outlined>
                <MudLink Href="@item.Href" Typo="Typo.h6">@item.Title</MudLink>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private int _attention;
    private DashboardFigures? _figures;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Has(TahsilPermissions.SubscriptionsRead) && Session.Has(TahsilPermissions.InvoicesRead) && Session.Has(TahsilPermissions.PaymentsRead))
        {
            _figures = await ReadAsync<GetDashboardHandler, DashboardFigures>((handler, token) => handler.HandleAsync(token));
        }

        if (Session.Has(TahsilPermissions.PaymentsRead))
        {
            var items = await ReadAsync<ListAttentionItemsHandler, Page<AttentionItemResponse>>((handler, token) => handler.HandleAsync(includeResolved: false, token));
            var workers = await ReadAsync<ListWorkerAttentionHandler, Page<WorkerAttentionResponse>>((handler, token) => handler.HandleAsync(token));
            _attention = (items?.Items.Count ?? 0) + (workers?.Items.Count ?? 0);
        }
    }
}
