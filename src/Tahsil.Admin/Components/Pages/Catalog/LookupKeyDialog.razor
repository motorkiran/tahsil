<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">If another price holds the key, it moves to this one, and applications that look prices up by key get this price from now on.</MudText>
        <MudTextField @bind-Value="_key" Label="Lookup key" Placeholder="pro-monthly-try" Clearable id="lookup-key" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(_key ?? string.Empty))">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _key;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter]
    public string? Current { get; set; }

    protected override void OnInitialized() => _key = Current;
}
