@page "/admin/settings"
@attribute [Authorize(Policy = AdminAuthentication.AdminOnlyPolicy)]
@using Tahsil.Admin.Settings
@inherits AdminPageBase
@inject EffectiveSettings Effective
@inject Microsoft.Extensions.Options.IOptions<ServerOptions> Server

<PageTitle>Settings · Tahsil</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom>Settings</MudText>
<MudText Typo="Typo.body2" Class="mb-4" id="settings-note">
    This installation runs in <strong id="mode">@(Server.Value.IsTestMode ? "Test" : "Live")</strong> mode with the configuration below, defaults included.
    It is read when Tahsil starts: change it in the environment or the settings file and restart. Secrets are never shown, only whether they are set.
</MudText>

@foreach (var part in _sections)
{
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2"><code>@part.Name</code></MudText>
    <MudSimpleTable Dense Elevation="0" Class="settings-section" data-section="@part.Name">
        <tbody>
            @foreach (var setting in part.Settings)
            {
                <tr data-key="@setting.Key">
                    <th style="width: 40%"><code>@setting.Key</code></th>
                    <td>@setting.Value@(setting is { IsSecret: true, Value: EffectiveSettings.Masked } ? " (set)" : null)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private IReadOnlyList<SettingsSection> _sections = [];

    protected override void OnInitialized() => _sections = Effective.Read();
}
