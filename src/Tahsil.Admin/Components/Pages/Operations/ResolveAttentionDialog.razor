<MudDialog>
    <DialogContent>
        <MudText Class="mb-2">
            Resolving records what was done; it changes nothing else. To rule on an uncertain payment, use <em>Resolve with evidence</em> on the payment instead.
        </MudText>
        <MudTextField @bind-Value="_resolution" Label="Resolution" Lines="2" Required MaxLength="500" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(_resolution!.Trim()))" Disabled="string.IsNullOrWhiteSpace(_resolution)">Resolve</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _resolution;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;
}
