@* Shows a secret Tahsil keeps only a hash of, which cannot be shown again. *@
<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">Copy it now: it is not shown again.</MudAlert>
        <MudTextField Value="Secret" Label="@Label" ReadOnly Variant="Variant.Outlined" Class="secret" id="secret" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public required string Secret { get; set; }

    [Parameter]
    public string Label { get; set; } = "Secret";

    public static async Task ShowAsync(IDialogService dialogs, string title, string label, string secret)
    {
        var parameters = new DialogParameters<SecretDialog> { { dialog => dialog.Secret, secret }, { dialog => dialog.Label, label } };
        var dialog = await dialogs.ShowAsync<SecretDialog>(title, parameters, new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false });
        await dialog.Result;
    }
}
