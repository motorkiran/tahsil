@inject AdminSession Session
@inject Microsoft.Extensions.Options.IOptions<ServerOptions> Server

<MudNavMenu>
    <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    @foreach (var item in VisibleItems(Session, Server.Value))
    {
        <MudNavLink Href="@item.Href" Icon="@item.Icon">@item.Title</MudNavLink>
    }
</MudNavMenu>

@code {
    /// <summary>The panel's sections; each shows to administrators whose role grants its permission.</summary>
    internal static readonly IReadOnlyList<NavItem> Items =
    [
        new("Attention", "/admin/attention", Icons.Material.Filled.ReportProblem, TahsilPermissions.PaymentsRead),
        new("Customers", "/admin/customers", Icons.Material.Filled.People, TahsilPermissions.CustomersRead),
        new("Subscriptions", "/admin/subscriptions", Icons.Material.Filled.Autorenew, TahsilPermissions.SubscriptionsRead),
        new("Invoices", "/admin/invoices", Icons.Material.Filled.ReceiptLong, TahsilPermissions.InvoicesRead),
        new("Payments", "/admin/payments", Icons.Material.Filled.Payments, TahsilPermissions.PaymentsRead),
        new("Products", "/admin/products", Icons.Material.Filled.Inventory2, TahsilPermissions.CatalogRead),
        new("Tax rates", "/admin/tax-rates", Icons.Material.Filled.Percent, TahsilPermissions.CatalogRead),
        new("Coupons", "/admin/coupons", Icons.Material.Filled.LocalOffer, TahsilPermissions.CouponsRead),
        new("Provider connections", "/admin/connections", Icons.Material.Filled.Hub, TahsilPermissions.ConnectionsRead),
        new("Webhooks", "/admin/webhooks", Icons.Material.Filled.Webhook, TahsilPermissions.WebhooksRead),
        new("API keys", "/admin/api-keys", Icons.Material.Filled.Key, TahsilPermissions.ApiKeysWrite),
        new("Audit log", "/admin/audit-log", Icons.Material.Filled.History, TahsilPermissions.AuditRead),
        new("Test mode", "/admin/test-mode", Icons.Material.Filled.Science, TahsilPermissions.TestWrite, TestModeOnly: true),
    ];

    /// <summary>The sections <paramref name="session"/>'s administrator may open in this installation's mode.</summary>
    internal static IEnumerable<NavItem> VisibleItems(AdminSession session, ServerOptions server) =>
        Items.Where(item => (item.Permission is null || session.Has(item.Permission)) && (!item.TestModeOnly || server.IsTestMode));

    internal sealed record NavItem(string Title, string Href, string Icon, string? Permission, bool TestModeOnly = false);
}
