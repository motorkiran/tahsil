@inherits LayoutComponentBase
@inject AdminSessionLoader SessionLoader
@inject AdminSession Session
@inject Microsoft.Extensions.Options.IOptions<Tahsil.Application.Common.ServerOptions> Server

<MudThemeProvider Theme="AdminTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Menu" />
        <MudText Typo="Typo.h6" Class="ml-2">Tahsil</MudText>
        @if (Server.Value.IsTestMode)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-3" id="test-mode">Test mode</MudChip>
        }
        <MudSpacer />
        @if (Session.IsLoaded)
        {
            <MudText Typo="Typo.body2" Class="mr-4" id="admin-identity">@(Session.Email ?? Session.Subject) · @Session.Role</MudText>
        }
        <MudButton Href="@AdminAuthentication.SignOutPath" Variant="Variant.Text" Color="Color.Inherit">Sign out</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @if (Session.IsLoaded)
            {
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <MudAlert Severity="Severity.Error" id="page-error">
                            Something went wrong on this page. Reference: @System.Diagnostics.Activity.Current?.TraceId.ToString()
                        </MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            }
            else
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" />
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private ErrorBoundary? _errorBoundary;

    protected override Task OnInitializedAsync() => SessionLoader.LoadAsync();

    // A page that failed recovers when the administrator goes to another one.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
