{%- capture subject -%}{% if order.mode == "setup" %}Kartınız kaydedildi{% else %}Siparişiniz alındı{% if order.number %} ({{ order.number }}){% endif %}{% endif %}{%- endcapture -%}
{%- capture html -%}
<p>Merhaba{% if customer.name %} {{ customer.name }}{% endif %},</p>
{% if order.mode == "setup" %}
<p>{{ order.card }} kartınız {{ merchant.name }} için sonraki ödemelerinizde kullanılmak üzere {{ order.date }} tarihinde kaydedildi. Şimdi bir ücret alınmadı.</p>
{% else %}
<p>{{ order.date }} tarihli siparişiniz için ödemeniz alındı. Teşekkür ederiz.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:16px 0;border-collapse:collapse;">
{% for item in order.items %}<tr><td style="padding:6px 0;border-bottom:1px solid #e3e5ea;">{{ item.description }}</td><td align="right" style="padding:6px 0;border-bottom:1px solid #e3e5ea;white-space:nowrap;">{{ item.amount }}</td></tr>
{% endfor %}{% if order.tax %}<tr><td style="padding:6px 0;color:#6b7280;">Dahil olan vergi</td><td align="right" style="padding:6px 0;color:#6b7280;">{{ order.tax }}</td></tr>{% endif %}
<tr><td style="padding:6px 0;font-weight:600;">Ödenen tutar</td><td align="right" style="padding:6px 0;font-weight:600;">{{ order.total }}</td></tr>
</table>
{% if order.number %}<p>Fatura numarası: {{ order.number }}</p>{% endif %}
{% endif %}
{% if documents.size > 0 %}<p>Kabul ettiğiniz belgeler ekte: {{ documents | join: ", " }}.</p>{% endif %}
<p style="color:#6b7280;font-size:13px;">Satıcı: {{ merchant.legal_name }}{% if merchant.mersis_number %}, MERSİS {{ merchant.mersis_number }}{% endif %}, {{ merchant.address }}, {{ merchant.phone }}, {{ merchant.email }}. Bu e-postayı {{ merchant.name }} üzerinden yaptığınız işlem nedeniyle alıyorsunuz.</p>
{%- endcapture -%}
{%- capture text -%}
Merhaba{% if customer.name %} {{ customer.name }}{% endif %},

{% if order.mode == "setup" %}{{ order.card }} kartınız {{ merchant.name }} için sonraki ödemelerinizde kullanılmak üzere {{ order.date }} tarihinde kaydedildi. Şimdi bir ücret alınmadı.
{% else %}{{ order.date }} tarihli siparişiniz için ödemeniz alındı. Teşekkür ederiz.

{% for item in order.items %}{{ item.description }}: {{ item.amount }}
{% endfor %}{% if order.tax %}Dahil olan vergi: {{ order.tax }}
{% endif %}Ödenen tutar: {{ order.total }}
{% if order.number %}Fatura numarası: {{ order.number }}
{% endif %}{% endif %}
{% if documents.size > 0 %}Kabul ettiğiniz belgeler ekte: {{ documents | join: ", " }}.
{% endif %}
Satıcı: {{ merchant.legal_name }}{% if merchant.mersis_number %}, MERSİS {{ merchant.mersis_number }}{% endif %}, {{ merchant.address }}, {{ merchant.phone }}, {{ merchant.email }}. Bu e-postayı {{ merchant.name }} üzerinden yaptığınız işlem nedeniyle alıyorsunuz.
{%- endcapture -%}
