{%- capture subject -%}Your invoice {{ invoice.number }} ({{ invoice.amount }}){%- endcapture -%}
{%- capture html -%}
<p>Hello{% if customer.name %} {{ customer.name }}{% endif %},</p>
<p>{{ merchant.name }} issued invoice {{ invoice.number }} to you. The amount due is <strong>{{ invoice.amount }}</strong>{% if invoice.due_date %}, payable by <strong>{{ invoice.due_date }}</strong>{% endif %}.</p>
{% if invoice.hosted_url %}<p><a href="{{ invoice.hosted_url }}" style="display:inline-block;padding:10px 18px;background:#111827;color:#ffffff;text-decoration:none;border-radius:8px;">View and pay the invoice</a></p>{% endif %}
{% if bank_transfer %}<p>You can also pay by bank transfer: {{ bank_transfer.bank }}, {{ bank_transfer.account_holder }}, IBAN {{ bank_transfer.iban }}. Please mention the invoice number ({{ invoice.number }}) in the transfer.</p>{% endif %}
<p style="color:#6b7280;font-size:13px;">You receive this email because of an invoice between you and {{ merchant.name }}.</p>
{%- endcapture -%}
{%- capture text -%}
Hello{% if customer.name %} {{ customer.name }}{% endif %},

