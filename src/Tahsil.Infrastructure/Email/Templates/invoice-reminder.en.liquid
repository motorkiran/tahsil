{%- capture subject -%}{% if reminder.days_overdue > 0 %}Overdue invoice {{ invoice.number }}{% elsif reminder.due_today %}Invoice {{ invoice.number }} is due today{% else %}Reminder: invoice {{ invoice.number }} is due in {{ reminder.days_left }} days{% endif %}{%- endcapture -%}
{%- capture html -%}
<p>Hello{% if customer.name %} {{ customer.name }}{% endif %},</p>
<p>{% if reminder.days_overdue > 0 %}Invoice {{ invoice.number }} was due on {{ invoice.due_date }}, {{ reminder.days_overdue }} days ago, and {{ invoice.amount }} is still unpaid.{% elsif reminder.due_today %}Invoice {{ invoice.number }} is due today. The amount due is {{ invoice.amount }}.{% else %}Invoice {{ invoice.number }} is due on {{ invoice.due_date }}. The amount due is {{ invoice.amount }}.{% endif %}</p>
{% if invoice.hosted_url %}<p><a href="{{ invoice.hosted_url }}" style="display:inline-block;padding:10px 18px;background:#111827;color:#ffffff;text-decoration:none;border-radius:8px;">Pay the invoice</a></p>{% endif %}
{% if bank_transfer %}<p>For a bank transfer: {{ bank_transfer.bank }}, {{ bank_transfer.account_holder }}, IBAN {{ bank_transfer.iban }}; mention {{ invoice.number }}.</p>{% endif %}
<p>If you have already paid, please ignore this email.</p>
<p style="color:#6b7280;font-size:13px;">You receive this email because of an invoice between you and {{ merchant.name }}.</p>
{%- endcapture -%}
{%- capture text -%}
