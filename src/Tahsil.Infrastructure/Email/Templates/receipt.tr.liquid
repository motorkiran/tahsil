{%- capture subject -%}Ödemeniz alındı: {{ invoice.number }}{%- endcapture -%}
{%- capture html -%}
<p>Merhaba{% if customer.name %} {{ customer.name }}{% endif %},</p>
<p>{{ invoice.number }} numaralı faturanızın ödemesi{% if invoice.paid_at %} {{ invoice.paid_at }} tarihinde{% endif %} alındı. Teşekkür ederiz.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:16px 0;border-collapse:collapse;">
{% for line in invoice.lines %}<tr><td style="padding:6px 0;border-bottom:1px solid #e3e5ea;">{{ line.description }}</td><td align="right" style="padding:6px 0;border-bottom:1px solid #e3e5ea;white-space:nowrap;">{{ line.amount }}</td></tr>
{% endfor %}{% if invoice.tax %}<tr><td style="padding:6px 0;color:#6b7280;">Vergi</td><td align="right" style="padding:6px 0;color:#6b7280;">{{ invoice.tax }}</td></tr>{% endif %}
<tr><td style="padding:6px 0;font-weight:600;">Ödenen tutar</td><td align="right" style="padding:6px 0;font-weight:600;">{{ invoice.paid }}</td></tr>
</table>
{% if invoice.card %}<p>Ödeme yöntemi: {{ invoice.card }}</p>{% endif %}
{% if invoice.legal_invoice_number %}<p>e-Arşiv / e-Fatura numarası: {{ invoice.legal_invoice_number }}</p>{% endif %}
{% if invoice.hosted_url %}<p><a href="{{ invoice.hosted_url }}">Faturayı görüntüle</a></p>{% endif %}
<p style="color:#6b7280;font-size:13px;">Bu e-postayı {{ merchant.name }} üzerinden yaptığınız ödeme nedeniyle alıyorsunuz.</p>
{%- endcapture -%}
{%- capture text -%}
Merhaba{% if customer.name %} {{ customer.name }}{% endif %},

{{ invoice.number }} numaralı faturanızın ödemesi{% if invoice.paid_at %} {{ invoice.paid_at }} tarihinde{% endif %} alındı. Teşekkür ederiz.

{% for line in invoice.lines %}{{ line.description }}: {{ line.amount }}
{% endfor %}{% if invoice.tax %}Vergi: {{ invoice.tax }}
{% endif %}Ödenen tutar: {{ invoice.paid }}
{% if invoice.card %}Ödeme yöntemi: {{ invoice.card }}
{% endif %}{% if invoice.legal_invoice_number %}e-Arşiv / e-Fatura numarası: {{ invoice.legal_invoice_number }}
{% endif %}{% if invoice.hosted_url %}Faturayı görüntüle: {{ invoice.hosted_url }}
{% endif %}
Bu e-postayı {{ merchant.name }} üzerinden yaptığınız ödeme nedeniyle alıyorsunuz.
{%- endcapture -%}
