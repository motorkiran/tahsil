{%- capture subject -%}Payment received: {{ invoice.number }}{%- endcapture -%}
{%- capture html -%}
<p>Hello{% if customer.name %} {{ customer.name }}{% endif %},</p>
<p>We received the payment of invoice {{ invoice.number }}{% if invoice.paid_at %} on {{ invoice.paid_at }}{% endif %}. Thank you.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:16px 0;border-collapse:collapse;">
{% for line in invoice.lines %}<tr><td style="padding:6px 0;border-bottom:1px solid #e3e5ea;">{{ line.description }}</td><td align="right" style="padding:6px 0;border-bottom:1px solid #e3e5ea;white-space:nowrap;">{{ line.amount }}</td></tr>
{% endfor %}{% if invoice.tax %}<tr><td style="padding:6px 0;color:#6b7280;">Tax</td><td align="right" style="padding:6px 0;color:#6b7280;">{{ invoice.tax }}</td></tr>{% endif %}
<tr><td style="padding:6px 0;font-weight:600;">Amount paid</td><td align="right" style="padding:6px 0;font-weight:600;">{{ invoice.paid }}</td></tr>
</table>
{% if invoice.card %}<p>Paid with {{ invoice.card }}</p>{% endif %}
{% if invoice.legal_invoice_number %}<p>Legal invoice number: {{ invoice.legal_invoice_number }}</p>{% endif %}
{% if invoice.hosted_url %}<p><a href="{{ invoice.hosted_url }}">View the invoice</a></p>{% endif %}
<p style="color:#6b7280;font-size:13px;">You receive this email because of a payment to {{ merchant.name }}.</p>
{%- endcapture -%}
{%- capture text -%}
Hello{% if customer.name %} {{ customer.name }}{% endif %},

We received the payment of invoice {{ invoice.number }}{% if invoice.paid_at %} on {{ invoice.paid_at }}{% endif %}. Thank you.

{% for line in invoice.lines %}{{ line.description }}: {{ line.amount }}
{% endfor %}{% if invoice.tax %}Tax: {{ invoice.tax }}
{% endif %}Amount paid: {{ invoice.paid }}
{% if invoice.card %}Paid with {{ invoice.card }}
{% endif %}{% if invoice.legal_invoice_number %}Legal invoice number: {{ invoice.legal_invoice_number }}
{% endif %}{% if invoice.hosted_url %}View the invoice: {{ invoice.hosted_url }}
{% endif %}
You receive this email because of a payment to {{ merchant.name }}.
{%- endcapture -%}
