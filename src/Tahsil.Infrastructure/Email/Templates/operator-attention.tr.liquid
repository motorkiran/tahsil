{%- capture subject -%}İlgilenilmesi gereken kayıt: {{ items[0].kind }}{%- endcapture -%}
{%- capture html -%}
{% for item in items %}<p><strong>{{ item.kind }}</strong>, {{ item.subject }}, {{ item.raised_at }}.</p>
{% if item.details.size > 0 %}<ul>{% for detail in item.details %}<li>{{ detail }}</li>{% endfor %}</ul>{% endif %}{% endfor %}
<p><a href="{{ admin_url }}">Listeyi aç</a></p>
{%- endcapture -%}
{%- capture text -%}
{% for item in items %}{{ item.kind }}, {{ item.subject }}, {{ item.raised_at }}.
{% for detail in item.details %}- {{ detail }}
{% endfor %}{% endfor %}
Listeyi aç: {{ admin_url }}
{%- endcapture -%}
