<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ seller.name }}</title>
</head>
<body style="margin:0;padding:0;background:#f5f6f8;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f5f6f8;padding:32px 16px;">
<tr>
<td align="center">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border:1px solid #e3e5ea;border-radius:12px;">
<tr>
<td style="padding:32px;font-size:15px;line-height:1.6;">
{% if product.logo_url %}<img src="{{ product.logo_url }}" alt="{{ seller.name }}" style="display:block;max-height:40px;margin-bottom:24px;">{% else %}<div style="font-size:18px;font-weight:700;color:{{ product.color }};margin-bottom:24px;">{{ seller.name }}</div>{% endif %}
{{ content | raw }}
</td>
</tr>
</table>
<p style="max-width:560px;color:#6b7280;font-size:12px;line-height:1.5;margin:16px auto 0;">{{ seller.legal_name }} · {{ seller.address }} · {{ seller.email }}</p>
</td>
</tr>
</table>
</body>
</html>
