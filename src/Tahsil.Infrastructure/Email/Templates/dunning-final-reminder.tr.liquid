{%- capture subject -%}Son hatırlatma: {{ invoice.number }}{%- endcapture -%}
{%- capture html -%}
<p>Merhaba{% if customer.name %} {{ customer.name }}{% endif %},</p>
<p>{{ invoice.number }} numaralı faturanın {{ invoice.amount }} tutarındaki ödemesini hâlâ alamadık.{% if cancel_date %} Ödenmezse aboneliğiniz {{ cancel_date }} tarihinde sona erecek.{% endif %}</p>
{% if invoice.hosted_url %}<p><a href="{{ invoice.hosted_url }}" style="display:inline-block;padding:10px 18px;background:#111827;color:#ffffff;text-decoration:none;border-radius:8px;">Faturayı öde</a></p>{% endif %}
<p style="color:#6b7280;font-size:13px;">Bu e-postayı {{ merchant.name }} aboneliğiniz veya faturanız nedeniyle alıyorsunuz.</p>
{%- endcapture -%}
{%- capture text -%}
Merhaba{% if customer.name %} {{ customer.name }}{% endif %},

