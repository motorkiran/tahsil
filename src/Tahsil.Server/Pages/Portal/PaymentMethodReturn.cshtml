@page "/portal/{token}/payment-method/return/{paymentId:guid}"
@using Tahsil.Server.Ui
@model Tahsil.Server.Pages.Portal.PaymentMethodReturnModel
@{
    ViewData["Title"] = L["Payment method"];
}

<h1 id="page-title">@L["Payment method"]</h1>
<p>@L["One moment…"]</p>
<a class="button" id="continue" href="@Model.NextUrl" target="_top">@L["Continue"]</a>
<script nonce="@HttpContext.GetCspNonce()">window.top.location.href = document.getElementById("continue").href;</script>
