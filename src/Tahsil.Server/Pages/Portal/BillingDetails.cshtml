@page "/portal/{token}/billing-details"
@model Tahsil.Server.Pages.Portal.BillingDetailsModel
@{
    ViewData["Title"] = L["Billing details"];
    var details = Model.Details;
}

<h1 id="page-title">@L["Billing details"]</h1>

@if (Model.ErrorMessage is { } error)
{
    <p class="alert alert-error" role="alert" id="portal-error">@error</p>
}

<form method="post" id="details-form">
    <div class="field">
        <label for="name">@L["Full name or company name"]</label>
        <input type="text" id="name" name="Details.Name" value="@details.Name" autocomplete="name" required />
    </div>
    <div class="field-pair">
        <div class="field">
            <label for="tax-id">@L["Tax number"]</label>
            <input type="text" id="tax-id" name="Details.TaxId" value="@details.TaxId" inputmode="numeric" />
        </div>
        <div class="field">
            <label for="tax-office">@L["Tax office"]</label>
            <input type="text" id="tax-office" name="Details.TaxOffice" value="@details.TaxOffice" />
        </div>
    </div>
    <div class="field">
        <label for="address">@L["Address"]</label>
        <input type="text" id="address" name="Details.AddressLine1" value="@details.AddressLine1" autocomplete="street-address" />
    </div>
    <div class="field-pair">
        <div class="field">
            <label for="city">@L["City"]</label>
            <input type="text" id="city" name="Details.City" value="@details.City" autocomplete="address-level2" />
        </div>
        <div class="field">
            <label for="postal-code">@L["Postal code"]</label>
            <input type="text" id="postal-code" name="Details.PostalCode" value="@details.PostalCode" autocomplete="postal-code" />
        </div>
    </div>
    <div class="field">
        <label for="phone">@L["Phone"]</label>
        <input type="tel" id="phone" name="Details.Phone" value="@details.Phone" autocomplete="tel" />
    </div>
    <button class="button" type="submit" id="save-details">@L["Save"]</button>
</form>

<p><a href="/portal/@Model.Token?done=overview" id="overview">@L["Back to billing"]</a></p>
