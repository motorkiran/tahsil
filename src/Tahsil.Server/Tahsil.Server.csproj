<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="Container image">
    <ContainerRepository>tahsil</ContainerRepository>
    <!-- The "extra" variant ships ICU and time zone data: Turkish money and date formatting and billing time zones need them. -->
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
  </PropertyGroup>

  <PropertyGroup Label="Admin panel">
    <!-- Serves Blazor's own script (_framework/blazor.web.js), which the admin panel's components need. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tahsil.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tahsil.Admin\Tahsil.Admin.csproj" />
    <ProjectReference Include="..\Tahsil.Application\Tahsil.Application.csproj" />
    <ProjectReference Include="..\Tahsil.Infrastructure\Tahsil.Infrastructure.csproj" />
    <ProjectReference Include="..\Tahsil.Providers.Simulator\Tahsil.Providers.Simulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
